DEBUG=1
SECRET_KEY=replace-with-a-long-random-value
ALLOWED_HOSTS=localhost,127.0.0.1
DB_PASSWORD=replace-with-a-random-database-password
# DATABASE_URL=postgres://dqtech:password@localhost:5432/dqtech

PUBLIC_BASE_URL=https://your-mall.example
CSRF_TRUSTED_ORIGINS=https://your-mall.example
# Generate once: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
GATEWAY_ENCRYPTION_KEY=replace-with-generated-fernet-key
# Enable only behind a trusted proxy that overwrites X-Forwarded-Proto.
TRUST_PROXY_HTTPS=0

# Platform-wide transactional email. Never put these credentials in seller settings.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.your-provider.example
EMAIL_PORT=587
EMAIL_HOST_USER=your-smtp-user
EMAIL_HOST_PASSWORD=your-smtp-password
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
DEFAULT_FROM_EMAIL=orders@your-mall.example
# Set empty to disable the browser location lookup.
GEO_LOOKUP_URL=https://api.bigdatacloud.net/data/reverse-geocode-client
WHATSAPP_GRAPH_VERSION=v27.0

# --- Mall Pay (marketplace Paystack account; split payments to seller subaccounts) ---
# Webhook URL to configure in the marketplace Paystack dashboard: https://your-mall.example/webhooks/paystack/platform/
PLATFORM_PAYSTACK_SECRET=
PLATFORM_PAYSTACK_CURRENCIES=GHS
# Track record required before a seller may connect their own Paystack account.
OWN_GATEWAY_MIN_DAYS=90
OWN_GATEWAY_MIN_DELIVERED_ORDERS=25
OWN_GATEWAY_MAX_REFUND_RATE=0.10
OWN_GATEWAY_OVERDUE_DAYS=30

# --- Hardening ---
# Number of reverse proxies in front of Django that append X-Forwarded-For (1 for a single nginx/Caddy).
TRUSTED_PROXY_COUNT=1
# Raise to 31536000 once HTTPS is confirmed stable on the domain.
SECURE_HSTS_SECONDS=3600
# Unpaid online/manual-payment orders release their stock after this many hours (0 disables).
UNPAID_ORDER_HOLD_HOURS=48
# Optional comma-separated allow-list of product image hosts; empty allows any HTTPS host.
PRODUCT_IMAGE_HOSTS=
# Error emails, "Name:email,Name:email".
ADMINS=
LOG_LEVEL=INFO
